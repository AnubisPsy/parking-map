# Copiar como .env (desarrollo) o .env.production (producción) y ajustar.
# Solo PORT suele ser necesario: el resto tiene valor por defecto.

# Puerto del servidor. En desarrollo debe coincidir con el proxy de vite.config.js (4040).
PORT=4040

# Solo si el frontend se sirve desde OTRO origen. Déjalo vacío si lo sirve este mismo Express.
FRONTEND_URL=

# development | test | production
# NODE_ENV=production

# Rutas. En producción deben quedar fuera de la carpeta de versión (ver OPERACION.md).
# DATA_DIR=C:\apps\parking-map\datos
# LOG_DIR=C:\apps\parking-map\logs
# FRONTEND_DIST=C:\apps\parking-map\actual\frontend\dist

# Registro: fatal | error | warn | info | debug | silent
# LOG_LEVEL=info
# LOG_RETENTION_DAYS=30

# A partir de cuántos ms un pedido se registra como lento
# SLOW_REQUEST_MS=3000
